# Every origin and name this handbook points at. Nothing here is a secret: all of it ships in the
# published HTML, and most of it appears inside documentation a developer reads and copies.
#
# `NEXT_PUBLIC_*` values are inlined at build time, so they must be set wherever `next build` runs.
# A static export has no runtime to read them later.
#
# Unlike the website repository, the defaults in `lib/shared.ts` are the real production hosts
# rather than localhost. The reason is the content: a quickstart telling someone to POST to
# http://localhost:4000 is worse than confidently wrong. A domain that is merely out of date is
# something a reader can work around; a localhost URL in published docs is not. So leaving these
# unset produces a correct site, and setting them is how you point it somewhere else.

# --- origins ---------------------------------------------------------------

# This handbook. Canonical URLs, the sitemap and the JSON-LD all build on it.
NEXT_PUBLIC_DOCS_URL=https://developer.thepulseapi.com

# The marketing site.
NEXT_PUBLIC_SITE_URL=https://thepulseapi.com

# The merchant dashboard: an account, and the API key every request in these docs needs.
NEXT_PUBLIC_APP_URL=https://app.thepulseapi.com

# The public API gateway.
NEXT_PUBLIC_API_URL=https://api.thepulseapi.com

# Asset CDN, which also serves the browser SDK.
NEXT_PUBLIC_CDN_URL=https://cdn.thepulseapi.com

# The demo storefront the concepts pages point at.
NEXT_PUBLIC_DEMO_URL=https://demo.thepulseapi.com

# --- paths, so a route or release needs no code change ---------------------

# The marketing site's bare URL redirects to /vi. This handbook is English-first, so it links to
# the English tree explicitly rather than sending an English reader to a Vietnamese page.
NEXT_PUBLIC_SITE_LOCALE_PATH=/en

# The API's version prefix, appended to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# The browser SDK under the CDN. Versioned by path, so a release is a variable change.
NEXT_PUBLIC_SDK_PATH=/sdk/v0/pulse.iife.js

# Deep links into the dashboard, as paths on NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_API_KEY_PATH=/settings/api
NEXT_PUBLIC_APP_SIGNUP_PATH=/register

# --- names -----------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=PULSE Developers
NEXT_PUBLIC_COMPANY_NAME=PULSE
# The legal entity, which is not the brand.
NEXT_PUBLIC_LEGAL_NAME=Resolve Labs
NEXT_PUBLIC_NPM_PACKAGE=@thepulseapi/sdk

# Drives the "Edit on GitHub" and history links.
NEXT_PUBLIC_GIT_USER=mypulseapi
NEXT_PUBLIC_GIT_REPO=handbook
NEXT_PUBLIC_GIT_BRANCH=main
